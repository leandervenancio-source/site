<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirecionar HTTP para HTTPS automaticamente
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Manter arquivos e pastas reais acessíveis diretamente (imagens, vídeos, css, js)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirecionar todas as rotas do React Router (/cfo-terceirizado, etc.) para index.html
  RewriteRule . /index.html [L]
</IfModule>

# Cache de ativos estáticos para alta performance na HostGator
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
